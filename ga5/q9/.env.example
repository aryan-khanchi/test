# --- Server ---
PORT=8080
DATA_DIR=./data

# --- Model provider: anthropic | ollama | openai | mock ---
# "mock" is only for the offline test suite; never use it in the deployed service.
MODEL_PROVIDER=openai

# Anthropic (recommended default: cheap, fast, strong JSON-schema adherence)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama (if MODEL_PROVIDER=ollama) - point this at wherever Ollama actually
# runs. If it's your home PC, this URL must be reachable from your deployed
# server, which is the reliability trade-off discussed in chat.
# OLLAMA_URL=http://127.0.0.1:11434/api/chat
# OLLAMA_MODEL=llama3.2

# OpenAI-compatible endpoint (if MODEL_PROVIDER=openai)
#
# AI Pipe (aipipe.org) example - get your token at https://aipipe.org/login:
OPENAI_BASE_URL=https://aipipe.org/openai/v1/chat/completions/
OPENAI_API_KEY=eyJhbGciOiJIUzI1NiJ9.eyJlbWFpbCI6IjI0ZjEwMDIxNTdAZHMuc3R1ZHkuaWl0bS5hYy5pbiIsImlhdCI6MTc4NTA3MjcxNiwiaXNzIjoiaHR0cHM6Ly9haXBpcGUub3JnIiwiYXVkIjoiYWlwaXBlLWFwaSIsImV4cCI6MTc4NTY3NzUxNn0.4-QcfuUyNlIxjNHCMQj_kpFSvWcmCQ-TMA2ZpgfABU8
OPENAI_MODEL=gpt-4.1-nano

# --- Batching / timeouts ---
# Number of dossiers per single model call. Larger = fewer round trips
# (helps fit the 55s request budget) but bigger prompts and more damage if
# one call fails. 8-15 is a reasonable range.
MODEL_CHUNK_SIZE=10
MODEL_TIMEOUT_MS=20000
